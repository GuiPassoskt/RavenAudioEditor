{
  "name": "raven-audio-editor",
  "version": "1.0.0",
  "description": "Editor de áudio multipista inspirado no Audacity 3.7.9, construído com Quasar Framework",
  "productName": "Raven Audio Editor",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "quasar dev",
    "dev:electron": "quasar dev -m electron",
    "build": "quasar build",
    "build:engine": "cmake -S engine -B engine/build -DCMAKE_BUILD_TYPE=Release && cmake --build engine/build --config Release",
    "build:electron": "quasar build -m electron",
    "licenses": "node scripts/generate-licenses.mjs",
    "test": "node --test \"tests/**/*.test.js\"",
    "postinstall": "quasar prepare"
  },
  "dependencies": {
    "@quasar/extras": "^1.16.17",
    "pinia": "^3.0.1",
    "quasar": "^2.18.1",
    "vue": "^3.5.13",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@quasar/app-vite": "^3.10.4",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "sass-embedded": "^1.86.0"
  },
  "engines": {
    "node": ">= 20"
  }
}
